# Environment variables for Elastic Beanstalk
# NOTE: Do NOT commit sensitive data here
# Set these in the EB Console Environment Properties instead:
# - DB_HOST
# - DB_USER
# - DB_PASSWORD
# - DB_NAME
# - JWT_SECRET

option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: "production"
    DB_PORT: "5432"
    DB_NAME: "daycare_db"
